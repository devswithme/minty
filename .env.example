# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Better Auth (Discord OAuth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me

DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret

# Discord bot
DISCORD_BOT_TOKEN=your-discord-bot-token
MENTOR_ROLE_ID=your-mentor-role-id

# Optional: register /ev command per guild (faster iteration)
DISCORD_GUILD_ID=

# Webhook security
TALLY_SIGNING_SECRET=change-me

# Internal API auth (used by /api/mentor/*)
DISCORD_INTERNAL_TOKEN=change-me

# Certificate rendering
# Defaults to assets/certificate-template.png
CERTIFICATE_TEMPLATE_PATH=

